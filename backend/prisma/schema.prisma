// Prisma schema = the "entities + Flyway/Liquibase" of this project in one file.
// Field names are snake_case on purpose: the SAME name is used in PostgreSQL, Prisma code,
// raw SQL, the JSON API and React, so there is no mapping layer to explain.
// Only the model names differ from the table names (@@map), e.g. model Customer -> table customers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES

  @@map("role")
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST

  @@map("enquiry_status")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED

  @@map("quotation_status")
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED

  @@map("sales_order_status")
}

model User {
  id            Int    @id @default(autoincrement())
  name          String
  email         String @unique
  password_hash String
  role          Role

  enquiries  Enquiry[]
  quotations Quotation[]

  @@map("users")
}

model Customer {
  id             Int     @id @default(autoincrement())
  company_name   String
  contact_person String
  mobile         String
  email          String?
  city           String?

  enquiries    Enquiry[]
  quotations   Quotation[]
  sales_orders SalesOrder[]

  @@map("customers")
}

model Product {
  id         Int     @id @default(autoincrement())
  code       String  @unique
  name       String
  category   String
  unit       String
  base_price Decimal @db.Decimal(12, 2)

  inventory         Inventory?
  enquiry_items     EnquiryItem[]
  quotation_items   QuotationItem[]
  sales_order_items SalesOrderItem[]

  @@map("products")
}

// One row per product. available = physical_qty - reserved_qty is NEVER stored (computed in code).
model Inventory {
  id           Int @id @default(autoincrement())
  product_id   Int @unique
  physical_qty Int @default(0)
  reserved_qty Int @default(0)

  product Product @relation(fields: [product_id], references: [id])

  @@map("inventory")
}

model Enquiry {
  id            Int           @id @default(autoincrement())
  enquiry_no    String        @unique
  customer_id   Int
  enquiry_date  DateTime      @default(now()) @db.Date
  required_date DateTime?     @db.Date
  notes         String?
  status        EnquiryStatus @default(NEW)
  created_by    Int

  customer   Customer      @relation(fields: [customer_id], references: [id])
  creator    User          @relation(fields: [created_by], references: [id])
  items      EnquiryItem[]
  quotations Quotation[]

  @@map("enquiries")
}

model EnquiryItem {
  id         Int @id @default(autoincrement())
  enquiry_id Int
  product_id Int
  quantity   Int

  // Deleting an enquiry deletes its items too.
  enquiry Enquiry @relation(fields: [enquiry_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id])

  @@map("enquiry_items")
}

model Quotation {
  id           Int             @id @default(autoincrement())
  quotation_no String          @unique
  enquiry_id   Int
  customer_id  Int
  valid_until  DateTime        @db.Date
  status       QuotationStatus @default(DRAFT)
  grand_total  Decimal         @db.Decimal(12, 2)
  created_by   Int

  enquiry     Enquiry         @relation(fields: [enquiry_id], references: [id])
  customer    Customer        @relation(fields: [customer_id], references: [id])
  creator     User            @relation(fields: [created_by], references: [id])
  items       QuotationItem[]
  sales_order SalesOrder?

  @@map("quotations")
}

model QuotationItem {
  id           Int     @id @default(autoincrement())
  quotation_id Int
  product_id   Int
  quantity     Int
  unit_price   Decimal @db.Decimal(12, 2)
  discount_pct Decimal @default(0) @db.Decimal(5, 2)
  gst_pct      Decimal @default(18) @db.Decimal(5, 2)
  line_amount  Decimal @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotation_id], references: [id])
  product   Product   @relation(fields: [product_id], references: [id])

  @@map("quotation_items")
}

model SalesOrder {
  id           Int              @id @default(autoincrement())
  order_no     String           @unique
  // Rule: UNIQUE quotation_id = one quotation can create at most one sales order.
  quotation_id Int              @unique
  customer_id  Int
  order_date   DateTime         @default(now()) @db.Date
  status       SalesOrderStatus @default(PENDING)
  total_amount Decimal          @db.Decimal(12, 2)

  quotation Quotation         @relation(fields: [quotation_id], references: [id])
  customer  Customer          @relation(fields: [customer_id], references: [id])
  items     SalesOrderItem[]
  dispatch  Dispatch?

  @@map("sales_orders")
}

model SalesOrderItem {
  id             Int @id @default(autoincrement())
  sales_order_id Int
  product_id     Int
  quantity       Int

  sales_order SalesOrder @relation(fields: [sales_order_id], references: [id])
  product     Product    @relation(fields: [product_id], references: [id])

  @@map("sales_order_items")
}

// Full dispatch only: what was dispatched = the sales order's items (no dispatch_items table).
model Dispatch {
  id             Int      @id @default(autoincrement())
  dispatch_no    String   @unique
  // Rule: UNIQUE sales_order_id = an order can be dispatched only once.
  sales_order_id Int      @unique
  dispatch_date  DateTime @default(now()) @db.Date
  vehicle_no     String
  driver_name    String

  sales_order SalesOrder @relation(fields: [sales_order_id], references: [id])

  @@map("dispatches")
}
